{
  "name": "pii-airlock-extension",
  "description": "Browser extension that automatically detects and scrubs PII from AI chat inputs",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:all": "wxt build && wxt build -b firefox && wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "zip:all": "wxt zip && wxt zip -b firefox && wxt zip -b edge",
    "fetch:ner": "bun run scripts/fetch-ner-assets.ts",
    "compile": "tsc --noEmit",
    "test": "bun test tests/",
    "e2e": "bun scripts/build-fixtures.ts && WXT_NER_HOST=http://127.0.0.1:4799 wxt build && playwright test",
    "postinstall": "wxt prepare",
    "store:assets": "bun scripts/store-promo.ts && bun scripts/store-compose.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "compromise": "^14.19.0",
    "franc-min": "^6.2.0",
    "libphonenumber-js": "^1.13.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.6",
    "@lexical/plain-text": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^21.0.4",
    "lexical": "^0.53.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9",
    "typescript": "^7.0.2",
    "wxt": "^0.20.27"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "brace-expansion": "^1.1.17",
    "vite": "^8.3.7",
    "source-map-js": "^1.2.2",
    "shell-quote": "^1.8.4",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "esbuild": "^0.28.2",
    "zod": "^4.6.7",
    "node-forge": "^1.4.3",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.32",
    "protobufjs": "^7.6.5",
    "happy-dom": "^21.0.4"
  }
}
